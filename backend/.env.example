# Copy to .env and adjust. Every value can also be set as an environment variable.
ENVIRONMENT=development

# SQLite for local development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://jalsetu:password@localhost:5432/jalsetu
DATABASE_URL=sqlite:///./jalsetu.db

# REQUIRED in production: a long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=15

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Road routing. The public OSRM demo server is fine for evaluation; self-host for production
# (https://github.com/Project-OSRM/osrm-backend with an India/Maharashtra OSM extract).
OSRM_URL=https://router.project-osrm.org

# Where trained models live (produced by ../ml)
ML_ARTIFACTS_DIR=../ml/artifacts

# Proof-of-delivery photo storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Bootstrap administrator created by `python -m scripts.seed`
ADMIN_EMAIL=admin@jalsetu.local
ADMIN_PASSWORD=ChangeMe!2026
