# API base URL. Leave unset in development: Vite proxies /api to the backend (see vite.config.ts).
# For a separately hosted API set the full URL, e.g. https://api.jalsetu.example.gov.in/api
# VITE_API_URL=/api

# Dev-proxy target for the backend
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Landing page: Google Photorealistic 3D Tiles for the descent (optional; without it the page uses its own
# Sentinel-2 + SRTM ground automatically). Create a key in Google Cloud with the "Map Tiles API" enabled and billing on,
# then RESTRICT it: Application restrictions -> Websites -> your domain(s) (and http://localhost:5173/* for dev);
# API restrictions -> Map Tiles API only. The key ships to browsers, so restrictions are what protect it.
# Put it in frontend/.env.local (git-ignored), not here.
# VITE_GOOGLE_MAPS_API_KEY=
